+class PSPL_PhotAstromParam4_RefPar(PSPL_PhotAstromParam4):
+    """PSPL parameters with thetaE and a reference-frame parallax.
+
+    Parameters
+    ----------
+    t0, u0_amp, tE, thetaE, piS : float
+        Peak time (MJD), impact parameter (Einstein radii), Einstein
